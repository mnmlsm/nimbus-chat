<Window x:Class="NimbusChat.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Background="AliceBlue">

        <!-- Hauptinhalt links oben -->
        <StackPanel Margin="30" HorizontalAlignment="Left" VerticalAlignment="Top">

            <TextBlock Text="Welcome!"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Weather Overview"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding WeatherCity, StringFormat=City: {0}}"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="{Binding WeatherTemperature, StringFormat=Temperature: {0}}"/>

                    <TextBlock Text="{Binding WeatherCondition, StringFormat=Condition: {0}}"/>
                </StackPanel>
            </Border>

            <WrapPanel>
                <Button Content="Profile"
                        Width="120" Height="40"
                        Margin="5"
                        Click="OpenProfile_Click"/>

                <Button Content="Weather"
                        Width="120" Height="40"
                        Margin="5"
                        Click="OpenWeather_Click"/>

                <Button Content="Messages"
                        Width="120" Height="40"
                        Margin="5"
                        Click="OpenMessages_Click"/>

                <Button Content="Settings"
                        Width="120" Height="40"
                        Margin="5"/>
            </WrapPanel>
        </StackPanel>

        <!-- Logout-Button unten rechts -->
        <Button Content="Logout"
                Width="100" Height="35"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Background="#444444"
                Foreground="White"
                Click="Logout_Click"/>
    </Grid>
</Window>