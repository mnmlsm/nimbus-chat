<Window x:Class="NimbusChat.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NimbusChat"
        Width="900"
        Height="650"
        Background="#F5F7FB"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Window.Resources>

        <Style x:Key="DashboardButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="65"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="Margin"
                    Value="12"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#4F8EF7"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="250"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="NimbusChat"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#202124"/>

            <TextBlock Text="{Binding WelcomeText}"
                       FontSize="17"
                       Foreground="#70757A"
                       Margin="0,8,0,25"/>

        </StackPanel>

        <!-- Cards -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="15"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- Weather -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="20"
                    Padding="25">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="2"
                                      Opacity="0.15"/>
                </Border.Effect>

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="170"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="☀"
                               FontSize="90"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Current Weather"
                                   FontSize="15"
                                   Foreground="#909090"/>

                        <TextBlock Text="{Binding WeatherCity}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="{Binding WeatherTemperature}"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Foreground="#4F8EF7"/>

                        <TextBlock Text="{Binding WeatherCondition}"
                                   FontSize="18"
                                   Foreground="#70757A"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Profile -->

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="20"
                    Padding="25">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="2"
                                      Opacity="0.15"/>
                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="👤"
                               FontSize="42"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="My Profile"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,10,0,20"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding Username}"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding UserStatus,
                                              StringFormat=Status: {0}}"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="{Binding FavoriteCity,
                                              StringFormat=Favorite City: {0}}"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Buttons -->

        <UniformGrid Grid.Row="2"
                     Columns="2"
                     Margin="0,3,0,2">

            <Button Style="{StaticResource DashboardButton}"
                    Content="👤  Profile"
                    Click="OpenProfile_Click"/>

            <Button Style="{StaticResource DashboardButton}"
                    Content="💬  Messages"
                    Click="OpenMessages_Click"/>

            <Button Style="{StaticResource DashboardButton}"
                    Content="🌤  Weather"
                    Click="OpenWeather_Click"/>

            <Button Style="{StaticResource DashboardButton}"
                    Content="⚙  Settings"/>

        </UniformGrid>

        <!-- Logout -->

        <Button Grid.Row="3"
                Width="170"
                Height="48"
                Content="Logout"
                Background="#202124"
                Foreground="White"
                FontSize="16"
                FontWeight="SemiBold"
                BorderThickness="0"
                HorizontalAlignment="Right"
                Click="Logout_Click">

            <Button.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.15"/>
            </Button.Effect>

        </Button>

    </Grid>

</Window>