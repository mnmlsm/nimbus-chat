<Window x:Class="NimbusChat.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:NimbusChat"
        Title="NimbusChat"
        Width="1280"
        Height="800"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#EDF4FC">

    <Window.Resources>
        
        

        <!-- ================= COLORS ================= -->

        <LinearGradientBrush x:Key="PageBackground"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#EDF4FC" Offset="0"/>
            <GradientStop Color="#DDEAF9" Offset="0.45"/>
            <GradientStop Color="#EEF4FA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#4468A9" Offset="0"/>
            <GradientStop Color="#7899C8" Offset="0.55"/>
            <GradientStop Color="#B8CBE0" Offset="1"/>
        </LinearGradientBrush>
        
        



        <!-- ================= SIDEBAR BUTTON ================= -->

        <Style x:Key="SidebarButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="Margin"
                    Value="12,4"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#DCE8F8"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#243F69"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ================= GLASS CARD ================= -->

        <Style x:Key="GlassCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#EFFFFFFF"/>

            <Setter Property="CornerRadius"
                    Value="24"/>

            <Setter Property="BorderBrush"
                    Value="#243B63"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect
                        BlurRadius="24"
                        ShadowDepth="5"
                        Opacity="0.10"/>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="QuickCard"
       TargetType="Border">

            <Setter Property="Background"
            Value="White"/>

            <Setter Property="CornerRadius"
            Value="22"/>

            <Setter Property="Margin"
            Value="8"/>

            <Setter Property="Padding"
            Value="20"/>

            <Setter Property="BorderBrush"
            Value="#E6EEF8"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="RenderTransformOrigin"
            Value="0.5,0.5"/>

            <Setter Property="RenderTransform">

                <Setter.Value>

                    <ScaleTransform/>

                </Setter.Value>

            </Setter>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect
                BlurRadius="18"
                ShadowDepth="4"
                Opacity="0.12"/>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- ================= SMALL ACTION BUTTON ================= -->

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Background"
                    Value="#162A49"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>



                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.85"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ================= ROOT ================= -->

    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="220"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="#142946"
                CornerRadius="0,28,28,0">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- Logo -->

                <StackPanel Margin="26,32,20,40">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="38"
                                Height="38"
                                CornerRadius="12"
                                Background="#5279B7">

                            <TextBlock Text="☁"
                                       Foreground="White"
                                       FontSize="21"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="NIMBUS"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="50,3,0,0">

                        <Ellipse x:Name="ConnectionDot"
                                 Width="8"
                                 Height="8"
                                 Fill="Gray"
                                 VerticalAlignment="Center"/>

                        <TextBlock x:Name="ConnectionText"
                                   Text="WEATHER · CONNECTED"
                                   Foreground="#7F9ABF"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="5,0,0,0"/>

                    </StackPanel>

                </StackPanel>


                <!-- Navigation -->

                <StackPanel Grid.Row="1">

                    <TextBlock Text="MENU"
                               Foreground="#6884AA"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="30,0,0,10"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="⌂     Dashboard"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="☁     Weather"
                            Click="OpenWeather_Click"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="✉     Messages"
                            Click="OpenMessages_Click"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="♙     Profile"
                            Click="OpenProfile_Click"/>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="⚙     Settings"/>

                </StackPanel>


                <!-- Bottom profile / logout -->

                <StackPanel Grid.Row="2"
                            Margin="14,0,14,22">

                    <Border Background="#1D385D"
                            CornerRadius="16"
                            Padding="14"
                            Margin="0,0,0,10">

                        <StackPanel Orientation="Horizontal">

                            <Border Width="38"
                                    Height="38"
                                    Background="{Binding AvatarBrush}"
                                    CornerRadius="19">

                                <TextBlock
                                    Text="{Binding UserInitial}"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Margin="10,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="{Binding Username}"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>

                                <TextBlock
                                           Text="{Binding UserStatus}"
                                           Foreground="{Binding UserStatusBrush}"
                                           FontSize="11"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <Button Style="{StaticResource SidebarButton}"
                            Content="↪     Logout"
                            Click="Logout_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="34,26,34,30">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================= HEADER ================= -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,22">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center">

                        <materialDesign:PackIcon
        Kind="{Binding GreetingIcon}"
        Width="28"
        Height="28"
        Margin="0,0,10,0"
        Foreground="#243B63"/>

                        <TextBlock
        Text="{Binding WelcomeText}"
        Style="{StaticResource TitleText}"
        Foreground="#243B63"
        VerticalAlignment="Center"/>

                    </StackPanel>


                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="42"
                                Height="42"
                                Background="#EFFFFFFF"
                                CornerRadius="14"
                                Margin="0,0,10,0">

                            <TextBlock Text="🔔"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <Button Style="{StaticResource ActionButton}"
                                Content="View weather"
                                Click="OpenWeather_Click"/>

                    </StackPanel>

                </Grid>


                <!-- ================= HERO WEATHER ================= -->

                <Border Grid.Row="1"
                        CornerRadius="28"
                        Background="{StaticResource HeroGradient}"
                        Height="280"
                        Margin="0,0,0,20">

                    <Border.Effect>

                        <DropShadowEffect
                            BlurRadius="30"
                            ShadowDepth="8"
                            Opacity="0.18"/>

                    </Border.Effect>



                    <Grid>

                        <!-- decorative atmosphere -->

                        <Ellipse Width="350"
                                 Height="350"
                                 Fill="#18FFFFFF"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-170,-80,0"/>

                        <Ellipse Width="220"
                                 Height="220"
                                 Fill="#0FFFFFFF"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,130,-130"/>


                        <Grid Margin="34">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="320"/>

                            </Grid.ColumnDefinitions>


                            <!-- Weather -->

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="CURRENT WEATHER"
                                           Foreground="#DDE9F8"
                                           FontSize="11"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding WeatherCity}"
                                           Foreground="White"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Margin="0,9,0,0"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,4,0,0">

                                    <TextBlock Text="{Binding WeatherTemperature}"
                                               Foreground="White"
                                               FontSize="44"
                                               FontWeight="Light"/>


                                </StackPanel>

                                <TextBlock Text="{Binding WeatherCondition}"
                                           Foreground="#EAF2FF"
                                           FontSize="18"
                                           Margin="0,8,0,0"/>

                                <StackPanel Orientation="Horizontal"
            Margin="0,16,0,0">

                                    <Border Background="#22FFFFFF"
            CornerRadius="12"
            Padding="12,6"
            Margin="0,0,10,0">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="💧"
                       FontSize="15"
                       />

                                            <TextBlock Text="{Binding WeatherHumidity}"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"/>
                                        </StackPanel>

                                    </Border>
                                    <Border Background="#22FFFFFF"
        CornerRadius="12"
        Padding="14,8"
        MinWidth="120">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="↝"
                       Foreground="White"
                       FontSize="18"
                       Margin="0,0,7,0"/>

                                            <TextBlock Text="{Binding WeatherWind}"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"/>
                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </StackPanel>

                            <!-- DYNAMIC WEATHER VISUAL -->
                            <Grid Width="300"
      Height="300"
      HorizontalAlignment="Right"
      Margin="0,0,20,0"
      VerticalAlignment="Center">

                                <!-- Soft ambient glow -->
                                <Ellipse Width="240"
             Height="240"
             Opacity="0.16">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- SUNNY -->
                                <Grid x:Name="SunnyVisual"
      Width="210"
      Height="210"
      Visibility="Collapsed">

                                    <!-- outer atmospheric glow -->
                                    <Ellipse Width="190"
             Height="190"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Opacity="0.35">

                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#80FFD978"
                              Offset="0"/>
                                                <GradientStop Color="#30FFD978"
                              Offset="0.5"/>
                                                <GradientStop Color="#00FFD978"
                              Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>

                                    </Ellipse>

                                    <!-- rotating rays -->
                                    <Grid Width="170"
          Height="170"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          RenderTransformOrigin="0.5,0.5">

                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="SunRotate"/>
                                        </Grid.RenderTransform>

                                        <Rectangle Width="7"
                   Height="30"
                   RadiusX="4"
                   RadiusY="4"
                   Fill="#FFE7A83D"
                   VerticalAlignment="Top"/>

                                        <Rectangle Width="7"
                   Height="30"
                   RadiusX="4"
                   RadiusY="4"
                   Fill="#FFE7A83D"
                   VerticalAlignment="Bottom"/>

                                        <Rectangle Width="30"
                   Height="7"
                   RadiusX="4"
                   RadiusY="4"
                   Fill="#FFE7A83D"
                   HorizontalAlignment="Left"/>

                                        <Rectangle Width="30"
                   Height="7"
                   RadiusX="4"
                   RadiusY="4"
                   Fill="#FFE7A83D"
                   HorizontalAlignment="Right"/>

                                        <Rectangle Width="7"
                   Height="27"
                   RadiusX="4"
                   RadiusY="4"
                   Fill="#FFE7A83D"
                   VerticalAlignment="Top"
                   RenderTransformOrigin="0.5,2.7">
                                            <Rectangle.RenderTransform>
                                                <RotateTransform Angle="45"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>

                                        <Rectangle Width="7"
                   Height="27"
                   RadiusX="4"
                   RadiusY="4"
                   Fill="#FFE7A83D"
                   VerticalAlignment="Bottom"
                   RenderTransformOrigin="0.5,-1.7">
                                            <Rectangle.RenderTransform>
                                                <RotateTransform Angle="45"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>

                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">

                                                        <DoubleAnimation
                            Storyboard.TargetName="SunRotate"
                            Storyboard.TargetProperty="Angle"
                            From="0"
                            To="360"
                            Duration="0:0:30"/>

                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>

                                    </Grid>

                                    <!-- sun body -->
                                    <Ellipse Width="130"
             Height="130"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

                                        <Ellipse.Fill>
                                            <RadialGradientBrush
                Center="0.35,0.30"
                GradientOrigin="0.35,0.30">

                                                <GradientStop Color="#FFFFE49A"
                              Offset="0"/>

                                                <GradientStop Color="#FFFFC94D"
                              Offset="0.55"/>

                                                <GradientStop Color="#FFF3A72F"
                              Offset="1"/>

                                            </RadialGradientBrush>
                                        </Ellipse.Fill>

                                        <Ellipse.Effect>
                                            <DropShadowEffect
                Color="#FFFFC34D"
                BlurRadius="35"
                ShadowDepth="0"
                Opacity="0.65"/>
                                        </Ellipse.Effect>

                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="SunPulse"
                            ScaleX="1"
                            ScaleY="1"/>
                                        </Ellipse.RenderTransform>

                                        <Ellipse.RenderTransformOrigin>
                                            <Point X="0.5"
                   Y="0.5"/>
                                        </Ellipse.RenderTransformOrigin>

                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>

                                                    <Storyboard
                        AutoReverse="True"
                        RepeatBehavior="Forever">

                                                        <DoubleAnimation
                            Storyboard.TargetName="SunPulse"
                            Storyboard.TargetProperty="ScaleX"
                            From="1"
                            To="1.06"
                            Duration="0:0:2.5"/>

                                                        <DoubleAnimation
                            Storyboard.TargetName="SunPulse"
                            Storyboard.TargetProperty="ScaleY"
                            From="1"
                            To="1.06"
                            Duration="0:0:2.5"/>

                                                    </Storyboard>

                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>

                                    </Ellipse>

                                    <!-- highlight -->
                                    <Ellipse Width="24"
             Height="15"
             Fill="#70FFFFFF"
             Margin="0,55,48,0"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"/>

                                </Grid>


                                <!-- CLOUDY -->
                                <Canvas x:Name="CloudyVisual"
           Visibility="Collapsed"
            Width="220"
            Height="170">

                                    <!-- back cloud -->
                                    <Ellipse Width="100"
                 Height="70"
                 Fill="#B8D0EE"
                 Canvas.Left="35"
                 Canvas.Top="55"
                 Opacity="0.65"/>

                                    <Ellipse Width="85"
                 Height="85"
                 Fill="#C9DCF3"
                 Canvas.Left="80"
                 Canvas.Top="30"/>

                                    <!-- front cloud -->
                                    <Ellipse Width="105"
                 Height="72"
                 Fill="White"
                 Canvas.Left="65"
                 Canvas.Top="78"/>

                                    <Ellipse Width="82"
                 Height="82"
                 Fill="White"
                 Canvas.Left="105"
                 Canvas.Top="53"/>

                                    <Ellipse Width="75"
                 Height="65"
                 Fill="White"
                 Canvas.Left="130"
                 Canvas.Top="82"/>

                                    <Rectangle Width="125"
                   Height="50"
                   RadiusX="25"
                   RadiusY="25"
                   Fill="White"
                   Canvas.Left="65"
                   Canvas.Top="100"/>

                                    <Canvas.Effect>
                                        <DropShadowEffect Color="#5479A8"
                              BlurRadius="25"
                              ShadowDepth="8"
                              Opacity="0.25"/>
                                    </Canvas.Effect>

                                    <Canvas.RenderTransform>
                                        <TranslateTransform x:Name="CloudMove"/>
                                    </Canvas.RenderTransform>

                                    <Canvas.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard AutoReverse="True"
                                RepeatBehavior="Forever">

                                                    <DoubleAnimation Storyboard.TargetName="CloudMove"
                                         Storyboard.TargetProperty="X"
                                         From="-7"
                                         To="7"
                                         Duration="0:0:3"/>

                                                    <DoubleAnimation Storyboard.TargetName="CloudMove"
                                         Storyboard.TargetProperty="Y"
                                         From="-2"
                                         To="4"
                                         Duration="0:0:4"/>

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Canvas.Triggers>

                                </Canvas>


                                <!-- RAIN -->
                                <Canvas x:Name="RainVisual"
            Visibility="Collapsed"
            Width="220"
            Height="200">

                                    <!-- cloud -->
                                    <Ellipse Width="105"
                 Height="75"
                 Fill="White"
                 Canvas.Left="50"
                 Canvas.Top="35"/>

                                    <Ellipse Width="90"
                 Height="90"
                 Fill="#EDF4FC"
                 Canvas.Left="95"
                 Canvas.Top="15"/>

                                    <Rectangle Width="135"
                   Height="55"
                   RadiusX="28"
                   RadiusY="28"
                   Fill="White"
                   Canvas.Left="50"
                   Canvas.Top="65"/>

                                    <!-- rain drops -->
                                    <Line X1="75" Y1="130"
              X2="65" Y2="160"
              Stroke="#BDE5FF"
              StrokeThickness="6"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

                                    <Line X1="115" Y1="130"
              X2="105" Y2="165"
              Stroke="#BDE5FF"
              StrokeThickness="6"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

                                    <Line X1="155" Y1="130"
              X2="145" Y2="160"
              Stroke="#BDE5FF"
              StrokeThickness="6"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

                                    <Canvas.RenderTransform>
                                        <TranslateTransform x:Name="RainMove"/>
                                    </Canvas.RenderTransform>

                                    <Canvas.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">

                                            <BeginStoryboard>

                                                <Storyboard AutoReverse="True"
                                RepeatBehavior="Forever">

                                                    <DoubleAnimation Storyboard.TargetName="RainMove"
                                         Storyboard.TargetProperty="Y"
                                         From="-3"
                                         To="8"
                                         Duration="0:0:0.7"/>

                                                </Storyboard>

                                            </BeginStoryboard>

                                        </EventTrigger>
                                    </Canvas.Triggers>

                                </Canvas>


                                <!-- SNOW -->
                                <Canvas x:Name="SnowVisual"
            Visibility="Collapsed"
            Width="220"
            Height="200">

                                    <Ellipse Width="105"
                 Height="75"
                 Fill="White"
                 Canvas.Left="50"
                 Canvas.Top="30"/>

                                    <Ellipse Width="90"
                 Height="90"
                 Fill="#EDF4FC"
                 Canvas.Left="95"
                 Canvas.Top="10"/>

                                    <Rectangle Width="135"
                   Height="55"
                   RadiusX="28"
                   RadiusY="28"
                   Fill="White"
                   Canvas.Left="50"
                   Canvas.Top="60"/>

                                    <TextBlock Text="❄"
                   FontSize="28"
                   Foreground="White"
                   Canvas.Left="65"
                   Canvas.Top="120"/>

                                    <TextBlock Text="❄"
                   FontSize="20"
                   Foreground="#D9EEFF"
                   Canvas.Left="110"
                   Canvas.Top="145"/>

                                    <TextBlock Text="❄"
                   FontSize="25"
                   Foreground="White"
                   Canvas.Left="155"
                   Canvas.Top="120"/>

                                </Canvas>

                            </Grid>
                        </Grid>

                    </Grid>

                </Border>

                <ItemsControl
                         Grid.Row="2"
                         Margin="0,0,0,20"
                         ItemsSource="{Binding Forecast}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border
        Margin="8"
        Padding="15"
        CornerRadius="22"
        Background="{Binding TileBackground}"
        BorderBrush="{Binding TileBorderBrush}"
        BorderThickness="1"
        RenderTransformOrigin="0.5,0.5">

                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CardScale"/>
                                </Border.RenderTransform>

                                <Border.Effect>
                                    <DropShadowEffect
                BlurRadius="28"
                ShadowDepth="6"
                Opacity="0.14"/>
                                </Border.Effect>

                                <Border.Style>

                                    <Style TargetType="Border">

                                        <Style.Triggers>

                                            <Trigger Property="IsMouseOver"
                             Value="True">

                                                <Setter Property="Cursor"
                                Value="Hand"/>

                                                <Trigger.EnterActions>

                                                    <BeginStoryboard>

                                                        <Storyboard>

                                                            <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                                        To="1.08"
                                        Duration="0:0:0.18"/>

                                                            <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                                        To="1.08"
                                        Duration="0:0:0.18"/>

                                                        </Storyboard>

                                                    </BeginStoryboard>

                                                </Trigger.EnterActions>

                                                <Trigger.ExitActions>

                                                    <BeginStoryboard>

                                                        <Storyboard>

                                                            <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.ScaleX"
                                        To="1"
                                        Duration="0:0:0.18"/>

                                                            <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.ScaleY"
                                        To="1"
                                        Duration="0:0:0.18"/>

                                                        </Storyboard>

                                                    </BeginStoryboard>

                                                </Trigger.ExitActions>

                                            </Trigger>

                                        </Style.Triggers>

                                    </Style>

                                </Border.Style>

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock
        Text="{Binding Day}"
        FontWeight="Bold"
        HorizontalAlignment="Center"/>

                                    <local:WeatherIconControl
        Width="58"
        Height="58"
        Margin="0,10"
        Condition="{Binding Condition}"/>

                                    <TextBlock
        Text="{Binding Temperature}"
        FontSize="24"
        FontWeight="Bold"
        HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- ================= WEATHER DETAILS ================= -->

                <Grid Grid.Row="3"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- Location -->

                    <Border Grid.Column="0"
                            Style="{StaticResource GlassCard}"
                            Padding="22">

                        <StackPanel>

                            <TextBlock Text="LOCATION"
                                       FontSize="10"
                                       Foreground="#8A99AC"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding WeatherCity}"
                                       FontSize="20"
                                       Foreground="#17253A"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,0"/>

                            <TextBlock
                                       Text="{Binding WeatherInfo}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"/>

                        </StackPanel>

                    </Border>


                    <!-- Condition -->

                    <Border Grid.Column="2"
                            Style="{StaticResource GlassCard}"
                            Padding="22">

                        <StackPanel>

                            <TextBlock Text="CONDITION"
                                       FontSize="10"
                                       Foreground="#8A99AC"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding WeatherCondition}"
                                       FontSize="20"
                                       Foreground="#17253A"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,0"/>

                            <TextBlock Text="Weather right now"
                                       Foreground="#8493A6"
                                       FontSize="12"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- Favorite city -->

                    <Border Grid.Column="4"
                            Style="{StaticResource GlassCard}"
                            Padding="22">

                        <StackPanel>

                            <TextBlock Text="FAVORITE CITY"
                                       FontSize="10"
                                       Foreground="#8A99AC"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding FavoriteCity}"
                                       FontSize="20"
                                       Foreground="#17253A"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,0"/>

                            <TextBlock Text="Saved to your profile"
                                       Foreground="#8493A6"
                                       FontSize="12"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================= BOTTOM ================= -->

                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1.3*"/>

                        <ColumnDefinition Width="18"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- Quick access -->

                    <UniformGrid Columns="3" Margin="0,10,0,0">

                        <!-- Weather -->
                        <Border Style="{StaticResource QuickCard}">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                              <Viewbox Width="34"
                                    Height="34"
                                    HorizontalAlignment="Center">

                                   <Canvas Width="24"
                                            Height="24">

                                    <Path
                                    Fill="#4F8EF7"
                                    Data="M19 18H6a4 4 0 010-8 5 5 0 019.6-1.7A4 4 0 1119 18z"/>

                               </Canvas>

                              </Viewbox>

                                <StackPanel Grid.Row="1">

                                    <TextBlock
                    Text="Weather"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#243B63"
                    HorizontalAlignment="Center"/>

                                    <TextBlock
                    Text="View forecast"
                    FontSize="13"
                    Foreground="#94A3B8"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"/>

                                </StackPanel>

                                <Button
                Grid.Row="2"
                Content="Open →"
                Style="{StaticResource ActionButton}"
                Height="40"
                Click="OpenWeather_Click"/>

                            </Grid>

                        </Border>

                        <!-- Messages -->
                        <Border Style="{StaticResource QuickCard}">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Viewbox Width="34"
                                    Height="34"
                                    HorizontalAlignment="Center">

                                    <Canvas Width="24"
                                               Height="24">

                                        <Path
                                     Fill="#8B5CF6"
                                     Data="M4 5h16v10H8l-4 4V5z"/>

                                    </Canvas>

                                </Viewbox>

                                <StackPanel Grid.Row="1">

                                    <TextBlock
                    Text="Messages"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#243B63"
                    HorizontalAlignment="Center"/>

                                    <TextBlock
                    Text="Open chats"
                    FontSize="13"
                    Foreground="#94A3B8"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"/>

                                </StackPanel>

                                <Button
                Grid.Row="2"
                Content="Open →"
                Style="{StaticResource ActionButton}"
                Height="40"
                Click="OpenMessages_Click"/>

                            </Grid>

                        </Border>

                        <!-- Profile -->
                        <Border Style="{StaticResource QuickCard}">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Viewbox Width="34"
                                    Height="34"
                                    HorizontalAlignment="Center">

                                    <Canvas Width="24"
                                            Height="24">

                                        <Path
                                        Fill="#10B981"
                                        Data="M12 12a4 4 0 100-8 4 4 0 000 8zm0 2c-4.4 0-8 2-8 4v2h16v-2c0-2-3.6-4-8-4z"/>

                                    </Canvas>

                                </Viewbox>

                                <StackPanel Grid.Row="1">

                                    <TextBlock
                    Text="Profile"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#243B63"
                    HorizontalAlignment="Center"/>

                                    <TextBlock
                    Text="Edit account"
                    FontSize="13"
                    Foreground="#94A3B8"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"/>

                                </StackPanel>

                                <Button
                Grid.Row="2"
                Content="Open →"
                Style="{StaticResource ActionButton}"
                Height="40"
                Click="OpenProfile_Click"/>

                            </Grid>

                        </Border>

                    </UniformGrid>


                    <!-- Profile overview -->

                    <Border Grid.Column="2"
                            Style="{StaticResource GlassCard}"
                            Padding="35">
                        
                    

                        <StackPanel>

                                <TextBlock
        Text="Your profile"
        FontSize="18"
        FontWeight="SemiBold"
        Foreground="#8FA0BC"/>

                                <Grid Margin="0,15,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                <Border Width="80"
        Height="80"
        CornerRadius="40"
        Background="{Binding AvatarBrush}"
        VerticalAlignment="Top" Margin="0,0,20,0">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.25"/>
                                    </Border.Effect>

                                    <TextBlock
        Text="{Binding UserInitial}"
        FontSize="34"
        FontWeight="Bold"
        Foreground="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel
            Grid.Column="1"
            Margin="25,5,0,0"
            VerticalAlignment="Top">

                                        <TextBlock
                Text="{Binding Username}"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#243B63" >
                                            
                                        </TextBlock>

                                        <TextBlock
                Text="{Binding UserStatus}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{Binding StatusBrush}"
                Margin="0,6,0,18"/>

                                        <TextBlock
                Text="Favorite city"
                FontSize="13"
                Foreground="#9AA9C2"/>

                                        <TextBlock
                Text="{Binding FavoriteCity}"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#243B63"
                Margin="0,0,0,12"/>

                                        <TextBlock
                Text="Weather dashboard"
                FontSize="13"
                Foreground="#9AA9C2"/>
                
                                        <TextBlock
                Text="Nimbus Connected"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#243B63"/>

                                        <TextBlock
                Text="Email"
                FontSize="13"
                Foreground="#9AA9C2"/>

                                        <TextBlock
                Text="{Binding Email}"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#243B63"/>

                                    </StackPanel>

                                </Grid>
                            </StackPanel>

                    </Border>

                </Grid>

            </Grid>

        </ScrollViewer>

    </Grid>

</Window>