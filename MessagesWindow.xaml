<Window x:Class="NimbusChat.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat"
        Height="500"
        Width="400"
        Background="AliceBlue"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox
        x:Name="UsersList"
        Grid.Column="0"
        SelectionChanged="UsersList_SelectionChanged"/>

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox
            x:Name="ChatList"
            Grid.Row="0"/>

                <DockPanel Grid.Row="1">

                    <TextBox
                x:Name="MessageInput"
                Margin="0,0,5,0" Width="115" TextChanged="MessageInput_TextChanged"/>

                    <Button
                Content="Send"
                Width="80"
                Click="Send_Click"/>

                </DockPanel>

            </Grid>

        </Grid>
    </Grid>
</Window>