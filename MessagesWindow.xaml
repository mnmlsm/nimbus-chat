<!-- Chat window layout: contacts on the left, conversation on the right. -->
<Window x:Class="NimbusChat.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:NimbusChat"
        Title="Messages"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>

        <local:StatusTranslationConverter
        x:Key="StatusTranslationConverter"/>

        <local:UsernameTranslationConverter
        x:Key="UsernameTranslationConverter"/>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================= LEFT: CONTACTS ================= -->

        <Border Grid.Column="0"
                Background="{DynamicResource CardBackground}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- Header -->

                <StackPanel Margin="25,25,25,20">

                    <TextBlock
                        x:Name="MessagesTitleText"
                        Text="Messages"
                        Style="{StaticResource TitleText}"
                        FontSize="26"
                        HorizontalAlignment="Left"/>

                    <TextBlock
                        x:Name="YourConversationsText"
                        Text="Your conversations"
                        Style="{StaticResource SubtitleText}"
                        HorizontalAlignment="Left"
                        Margin="0,3,0,0"/>

                </StackPanel>


                <!-- Search -->

                <Grid Grid.Row="1"
                      Margin="25,0,25,18">

                    <TextBox
                        x:Name="SearchBox"
                        Style="{StaticResource RoundedTextBox}"
                        Height="48"
                        TextChanged="SearchBox_TextChanged"
                        GotFocus="SearchBox_GotFocus"
                        LostFocus="SearchBox_LostFocus"/>

                    <TextBlock
                        x:Name="SearchPlaceholder"
                        Text="Search..."
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        IsHitTestVisible="False"/>

                </Grid>


                <!-- Users -->

                <ListBox
                    x:Name="UsersList"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,0"
                    SelectionChanged="UsersList_SelectionChanged">

                    <ListBox.Resources>

                        <Style TargetType="ListBoxItem">

                            <Setter Property="Margin"
                                    Value="4,4"/>

                            <Setter Property="Padding"
                                    Value="0"/>

                            <Setter Property="Background"
                                    Value="Transparent"/>

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border
                                            x:Name="ItemBorder"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            CornerRadius="14"
                                            Padding="12">

                                            <ContentPresenter/>

                                        </Border>


                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsSelected"
                                                     Value="True">

                                                <Setter
                                                    TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="{DynamicResource PrimaryBrush}"/>

                                            </Trigger>


                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter
                                                    TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="{DynamicResource InputBorderBrush}"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </ListBox.Resources>


                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- Avatar -->

                                <Border
                                    Width="48"
                                    Height="48"
                                    CornerRadius="24"
                                    Background="{Binding AvatarBrush}">

                                    <TextBlock
                                        Text="{Binding Initial}"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>


                                <!-- User info -->

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="14,0,4,0"
                                    VerticalAlignment="Center">

                                    <TextBlock
    Text="{Binding Converter={StaticResource UsernameTranslationConverter}}"
    FontSize="16"
    FontWeight="SemiBold"
    Foreground="{DynamicResource PrimaryTextBrush}"
    TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
    Text="{Binding Status, Converter={StaticResource StatusTranslationConverter}}"
    FontSize="12"
    Foreground="{DynamicResource SecondaryTextBrush}"
    TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </Grid>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>


        <!-- Divider -->

        <Border Grid.Column="0"
                Width="1"
                HorizontalAlignment="Right"
                Background="{DynamicResource InputBorderBrush}"/>


        <!-- ================= RIGHT: CHAT ================= -->

        <Grid Grid.Column="1"
              Background="{DynamicResource WindowBackground}">

            <Grid.RowDefinitions>
                <RowDefinition Height="86"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="86"/>
            </Grid.RowDefinitions>


            <!-- ================= CHAT HEADER ================= -->

            <Border
                Grid.Row="0"
                Background="{DynamicResource CardBackground}">

                <Grid Margin="15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <!-- User -->

                    <StackPanel Orientation="Horizontal">

                        <Border
    x:Name="AvatarBorder"
    Width="48"
    Height="48"
    CornerRadius="24"
    Background="{DynamicResource PrimaryBrush}">

                            <TextBlock
    x:Name="AvatarLetter"
    Text="A"
    FontSize="19"
    FontWeight="Bold"
    Foreground="White"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    TextAlignment="Center"
    Padding="0,1,0,0"/>

                        </Border>


                        <StackPanel
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                x:Name="ChatHeader"
                                Text="Select a chat"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontSize="18"
                                FontWeight="Bold"
                                TextTrimming="CharacterEllipsis"/>

                            <TextBlock
                                x:Name="ChatStatus"
                                Text=""
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="12"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- Header buttons -->

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Button
                            Width="42"
                            Height="42"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderThickness="0"
                            Style="{StaticResource IconButton}">

                            <materialDesign:PackIcon
                                Kind="Phone"
                                Width="19"
                                Height="19"
                                Foreground="{DynamicResource PrimaryTextBrush}"/>

                        </Button>


                        <Button
                            Width="42"
                            Height="42"
                            Margin="8,0,0,0"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderThickness="0"
                            Style="{StaticResource IconButton}">

                            <materialDesign:PackIcon
                                Kind="Video"
                                Width="19"
                                Height="19"
                                Foreground="{DynamicResource PrimaryTextBrush}"/>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================= MESSAGES ================= -->

            <ListBox
                x:Name="ChatList"
                Grid.Row="1"
                Margin="20,16"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,6"
                            Padding="12"
                            CornerRadius="16"
                            MaxWidth="430"
                            MinWidth="110">

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Setter
                                        Property="Background"
                                        Value="{DynamicResource InputBackgroundBrush}"/>

                                    <Setter
                                        Property="HorizontalAlignment"
                                        Value="Left"/>


                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsMine}"
                                            Value="True">

                                            <Setter
                                                Property="Background"
                                                Value="{DynamicResource PrimaryBrush}"/>

                                            <Setter
                                                Property="HorizontalAlignment"
                                                Value="Right"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>


                            <StackPanel>

                                <!-- Sender -->

                                <TextBlock
                                    Text="{Binding SenderName}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,4"
                                    Foreground="{DynamicResource PrimaryBrush}">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible"/>

                                            <Style.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding SenderName}"
                                                    Value="{x:Null}">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>


                                <!-- Message -->

                                <TextBlock
                                    Text="{Binding Content}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    FontSize="15"
                                    TextWrapping="Wrap"/>


                                <!-- Time -->

                                <TextBlock
                                    Text="{Binding Time}"
                                    HorizontalAlignment="Right"
                                    Margin="0,6,0,0"
                                    FontSize="10"
                                    Foreground="{DynamicResource SecondaryTextBrush}"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>


            <!-- ================= MESSAGE INPUT ================= -->

            <Grid
                Grid.Row="2"
                Margin="20,10,20,20">

                <Border
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="6">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <TextBox
    x:Name="MessageInput"
    Grid.Column="0"
    Background="Transparent"
    BorderThickness="0"
    Foreground="{DynamicResource PrimaryTextBrush}"
    FontSize="15"
    Padding="12,0"
    VerticalContentAlignment="Center"
    TextChanged="MessageInput_TextChanged"
    KeyDown="MessageInput_KeyDown" Height="44" VerticalAlignment="Center"/>


                        <Button
    x:Name="SendButton"
    Grid.Column="1"
    Width="34"
    Height="34"
    Margin="6,0,0,0"
    Background="{DynamicResource PrimaryBrush}"
    BorderBrush="{DynamicResource PrimaryBrush}"
    BorderThickness="0"
    Click="Send_Click"
    HorizontalContentAlignment="Center"
    VerticalContentAlignment="Center"
    Padding="0">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="18">

                                        <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                            <materialDesign:PackIcon
        Kind="Send"
        Width="20"
        Height="20"
        Foreground="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

                        </Button>
                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>