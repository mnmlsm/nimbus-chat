<Window x:Class="NimbusChat.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Messages"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT ================= -->

        <Border Grid.Column="0"
                Background="{StaticResource CardBackground}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="25">

                    <TextBlock
                        Text="Messages"
                        Style="{StaticResource TitleText}"/>

                    <TextBlock
                        Text="Your conversations"
                        Style="{StaticResource SubtitleText}"/>

                </StackPanel>

                <Grid Grid.Row="1" Margin="25,0,25,20">

                    <TextBox
        x:Name="SearchBox"
        Style="{StaticResource RoundedTextBox}"
        TextChanged="SearchBox_TextChanged"
        GotFocus="SearchBox_GotFocus"
        LostFocus="SearchBox_LostFocus"/>

                    <TextBlock
        x:Name="SearchPlaceholder"
        Text="Search..."
        Margin="15,0,0,0"
        VerticalAlignment="Center"
        Foreground="Gray"
        IsHitTestVisible="False"/>

                </Grid>

                <ListBox
    x:Name="UsersList"
    Grid.Row="2"
    Background="Transparent"
    BorderThickness="0"
    SelectionChanged="UsersList_SelectionChanged">

                    <ListBox.Resources>

                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="8,4"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>

                            <Setter Property="Template">
                                <Setter.Value>

                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border
                            x:Name="ItemBorder"
                            Background="#24324D"
                            CornerRadius="14"
                            Padding="12">

                                            <ContentPresenter/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#30415F"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Setter.Value>
                            </Setter>

                        </Style>

                    </ListBox.Resources>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->

                                <Border
    Width="48"
    Height="48"
    CornerRadius="24"
    Background="{StaticResource PrimaryBrush}">

                                    <TextBlock
        Text="A"
        FontSize="18"
        FontWeight="Bold"
        Foreground="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

                                </Border>

                                <!-- User -->

                                <StackPanel
                    Grid.Column="1"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center">

                                    <TextBlock
                        Text="{Binding Username}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                                    <TextBlock
                        Text="{Binding Status}"
                        FontSize="12"
                        Foreground="#AEB9CA"/>

                                </StackPanel>

                            </Grid>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>

        <!-- Divider -->

        <Border Grid.Column="0"
                Width="1"
                HorizontalAlignment="Right"
                Background="#324564"/>

        <!-- ================= CHAT ================= -->

        <Grid Grid.Column="1"
              Background="#162540">

            <Grid.RowDefinitions>

                <RowDefinition Height="80"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="90"/>

            </Grid.RowDefinitions>

            <!-- Header -->

            <Border
                Background="{StaticResource CardBackground}">

                <Grid Margin="20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <Border
    x:Name="AvatarBorder"
    Width="48"
    Height="48"
    CornerRadius="24"
    Background="{StaticResource PrimaryBrush}">

                            <TextBlock
        x:Name="AvatarLetter"
        Text="A"
        FontSize="20"
        FontWeight="Bold"
        Foreground="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="15,0">

                            <TextBlock
                                x:Name="ChatHeader"
                                Text="Select a chat"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="ChatStatus"
                                Foreground="#59E77C"/>

                        </StackPanel>

                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal">

                        <Button
                            Width="42"
                            Height="42"
                            Background="#253552"
                            BorderThickness="0">

                            <materialDesign:PackIcon
                                Kind="Phone"
                                Width="20"
                                Height="20"
                                Foreground="White"/>

                        </Button>

                        <Button
                            Width="42"
                            Height="42"
                            Margin="10,0,0,0"
                            Background="#253552"
                            BorderThickness="0">

                            <materialDesign:PackIcon
                                Kind="Video"
                                Width="20"
                                Height="20"
                                Foreground="White"/>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Messages -->

            <ListBox
    x:Name="ChatList"
    Grid.Row="1"
    Margin="20"
    Background="Transparent"
    BorderThickness="0">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Border
                Margin="0,8"
                Padding="12"
                CornerRadius="16"
                MaxWidth="350"
                MinWidth="110">

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Setter Property="Background" Value="#2B3A57"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="HorizontalAlignment"
                                        Value="Right"/>
                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <StackPanel>

                                <TextBlock
                        Text="{Binding Content}"
                        Foreground="White"
                        FontSize="15"
                        TextWrapping="Wrap"/>

                                <TextBlock
                        Text="{Binding Time}"
                        HorizontalAlignment="Right"
                        Margin="0,6,0,0"
                        FontSize="10"
                        Foreground="#CFCFCF"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

            <!-- Bottom -->

            <Grid Grid.Row="2"
                  Margin="20">

                <Border
                    Background="#253552"
                    CornerRadius="24"
                    Padding="8">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBox
                             x:Name="MessageInput"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="15"
                             VerticalContentAlignment="Center"
                             TextChanged="MessageInput_TextChanged"
                             KeyDown="MessageInput_KeyDown"/>

                        <Button
                             Background="{StaticResource PrimaryBrush}"
                             BorderThickness="0"
                             Click="Send_Click" Margin="650,-6,29,-6"
                            >
                            
                            

                            <materialDesign:PackIcon
        Kind="Send"
        Width="20"
        Height="20"
        Foreground="White"/>

                        </Button>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>