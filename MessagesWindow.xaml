<Window x:Class="NimbusChat.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NimbusChat"
        Width="950"
        Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FB">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
        Background="White"
        CornerRadius="20"
        Padding="15">

            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.15"/>
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- Title -->

                <TextBlock Text="Messages"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

                <!-- Search -->

                <TextBox x:Name="SearchBox"
                 Grid.Row="1"
                 Height="40"
                 Margin="0,0,0,15"
                 Padding="10"
                 VerticalContentAlignment="Center"
                 TextChanged="SearchBox_TextChanged"/>

                <!-- Users -->

                <ListBox x:Name="UsersList"
                 Grid.Row="2"
                 BorderThickness="0"
                 Background="Transparent"
                 SelectionChanged="UsersList_SelectionChanged">

                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem">

                            <Setter Property="Padding"
                            Value="12"/>

                            <Setter Property="Margin"
                            Value="0,4"/>

                            <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>

                        </Style>

                    </ListBox.ItemContainerStyle>

                </ListBox>

            </Grid>

        </Border>

        <!-- RIGHT SIDE -->

        <Border Grid.Column="2"
                Background="White"
                CornerRadius="20"
                Padding="20">

            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="2"
                                  Opacity="0.15"/>
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->

                <Border Background="#4F8EF7"
                        CornerRadius="12"
                        Padding="15">

                    <TextBlock Text="Private Chat"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>

                </Border>

                <!-- Chat -->

                <ListBox x:Name="ChatList"
                         Grid.Row="1"
                         Margin="0,20"
                         Background="Transparent"
                         BorderThickness="0">

                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem">

                            <Setter Property="Margin"
                                    Value="0,6"/>

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                        </Style>

                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Background="#EEF3FF"
                                    CornerRadius="15"
                                    Padding="12"
                                    Margin="5">

                                <TextBlock Text="{Binding}"
                                           FontSize="15"
                                           TextWrapping="Wrap"/>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <!-- Bottom -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="130"/>

                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageInput"
                             Grid.Column="0"
                             Height="45"
                             Margin="0,0,10,0"
                             Padding="12"
                             VerticalContentAlignment="Center"
                             TextChanged="MessageInput_TextChanged"/>

                    <Button Grid.Column="1"
                            Height="45"
                            Content="Send"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Background="#4F8EF7"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Send_Click"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>