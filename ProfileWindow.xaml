<Window x:Class="NimbusChat.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile"
        Height="500"
        Width="500"
        MinHeight="400"
        MinWidth="400"
        Background="AliceBlue"
        WindowStartupLocation="CenterScreen">

    <Grid Background="AliceBlue">
        <StackPanel Margin="30">

            <TextBlock Text="User Profile"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Username -->
            <TextBlock Text="Username"/>
            <TextBox x:Name="UsernameBox"
                     Height="30"
                     Margin="0,5,0,15"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Email -->
            <TextBlock Text="Email"/>
            <TextBox x:Name="EmailBox"
                     Height="30"
                     Margin="0,5,0,15"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Status -->
            <ComboBox x:Name="StatusBox"
          SelectedItem="{Binding Status}">
                <ComboBoxItem Content="Online"/>
                <ComboBoxItem Content="Away"/>
                <ComboBoxItem Content="Busy"/>
                <ComboBoxItem Content="Offline"/>
            </ComboBox>
            <!-- Favorite City -->
            <TextBlock Text="Favorite City"/>
            <TextBox x:Name="CityBox"
                     Height="30"
                     Margin="0,5,0,20"
                     Text="{Binding FavoriteCity, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Meldungen -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       Margin="0,0,0,5"/>

            <TextBlock Text="{Binding SuccessMessage}"
                       Foreground="Green"
                       Margin="0,0,0,10"/>

            <!-- Save-Button -->
            <Button Content="Save"
                    Height="35"
                    Width="100"
                    HorizontalAlignment="Right"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>