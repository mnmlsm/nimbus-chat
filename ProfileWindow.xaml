<Window x:Class="NimbusChat.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Profile"
        Height="780"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">

    <Grid>

        <Ellipse Width="420"
                 Height="420"
                 Fill="#18FFFFFF"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="120,-150,0,0"/>

        <Ellipse Width="220"
                 Height="220"
                 Fill="#14FFFFFF"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-70,0,0,-60"/>

        <Border Width="360"
                Padding="35"
                Background="{StaticResource CardBackground}"
                CornerRadius="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.30"/>
            </Border.Effect>

            <StackPanel>

                <!-- Logo -->
                <Border Width="80"
                        Height="80"
                        CornerRadius="40"
                        Background="#24344E"
                        HorizontalAlignment="Center">

                    <materialDesign:PackIcon
                        Kind="AccountCircleOutline"
                        Width="42"
                        Height="42"
                        Foreground="{StaticResource PrimaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

                <TextBlock Text="Edit Profile"
                           Style="{StaticResource TitleText}"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Update your account details"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,0,0,25"/>

                <!-- Username -->
                <TextBlock Text="USERNAME"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="4,0,0,8"/>

                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource RoundedTextBox}"
                         Margin="0,0,0,16"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Email -->
                <TextBlock Text="EMAIL"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="4,0,0,8"/>

                <TextBox x:Name="EmailBox"
                         Style="{StaticResource RoundedTextBox}"
                         Margin="0,0,0,16"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Status -->
                <TextBlock Text="STATUS"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="4,0,0,8"/>

                <ComboBox Style="{StaticResource RoundedComboBox}"
                          Margin="0,0,0,16"
                          SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="Online"/>
                    <ComboBoxItem Content="Away"/>
                    <ComboBoxItem Content="Busy"/>
                    <ComboBoxItem Content="Offline"/>
                </ComboBox>

                <!-- Favorite City -->
                <TextBlock Text="FAVORITE CITY"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="4,0,0,8"/>

                <TextBox x:Name="CityBox"
                         Style="{StaticResource RoundedTextBox}"
                         Margin="0,0,0,20"
                         Text="{Binding FavoriteCity, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Messages -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FF6B6B"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="#4ADE80"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <!-- Save -->
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Save Changes"
                        Click="Save_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>
