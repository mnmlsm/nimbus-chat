<!-- Login screen layout: logo, email/password fields, sign-in button, and a
     link to the registration window. -->
<Window x:Class="NimbusChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="NimbusChat"
        Height="700"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        ResizeMode="NoResize">

        <Grid>

            <!-- Decorative background -->
        <Ellipse Width="500"
             Height="500"
             Fill="#18FFFFFF"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Margin="150,-180,0,0"/>

        <Ellipse Width="260"
             Height="260"
             Fill="#14FFFFFF"
             HorizontalAlignment="Left"
             VerticalAlignment="Bottom"
             Margin="-80,0,0,-70"/>

        <!-- Server connection indicator -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,24,0,0">

            <Ellipse x:Name="ConnectionDot"
                     Width="8"
                     Height="8"
                     Fill="Gray"
                     VerticalAlignment="Center"/>

            <TextBlock x:Name="ConnectionText"
                       Text="SERVER · CONNECTED"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Margin="5,0,0,0"/>

        </StackPanel>

        <!-- Login Card -->
        <Border Width="390"
            Padding="40"
            Background="{StaticResource CardBackground}"
            CornerRadius="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                              ShadowDepth="0"
                              Opacity="0.30"/>
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <!-- 0 Logo -->
                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>
                    <!-- 2 Title -->
                    <RowDefinition Height="10"/>

                    <RowDefinition Height="Auto"/>
                    <!-- 4 Subtitle -->
                    <RowDefinition Height="35"/>

                    <RowDefinition Height="Auto"/>
                    <!-- 6 Email label -->
                    <RowDefinition Height="Auto"/>
                    <!-- 7 Email -->

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>
                    <!-- 9 Password label -->
                    <RowDefinition Height="Auto"/>
                    <!-- 10 Password -->

                    <RowDefinition Height="28"/>

                    <RowDefinition Height="Auto"/>
                    <!-- 12 Error -->

                    <RowDefinition Height="10"/>

                    <RowDefinition Height="Auto"/>
                    <!-- 14 Button -->

                    <RowDefinition Height="30"/>

                    <RowDefinition Height="Auto"/>
                    <!-- 16 Register -->

                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0"
        Width="80"
        Height="80"
        CornerRadius="40"
        Background="#24344E"
        HorizontalAlignment="Center">

                    <materialDesign:PackIcon
        Kind="Cloud"
        Width="42"
        Height="42"
        Foreground="{StaticResource PrimaryBrush}"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"/>

                </Border>

                <!-- Title -->
                <TextBlock Grid.Row="2"
           Text="NimbusChat"
           Style="{StaticResource TitleText}"
           HorizontalAlignment="Center"/>

                <!-- Subtitle -->
                <TextBlock Grid.Row="4"
           Text="Connect • Weather • Chat"
           Style="{StaticResource SubtitleText}"
           HorizontalAlignment="Center"/>

                <!-- Email -->
                <TextBlock Grid.Row="6"
           Text="EMAIL"
           Foreground="{StaticResource SecondaryTextBrush}"
           FontWeight="SemiBold"
           FontSize="12"
           Margin="4,0,0,8"/>

                <Grid Grid.Row="7">

                    <TextBox
    Style="{StaticResource RoundedTextBox}"
    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                </Grid>

                <!-- Password -->
                <TextBlock Grid.Row="9"
           Text="PASSWORD"
           Foreground="{StaticResource SecondaryTextBrush}"
           FontWeight="SemiBold"
           FontSize="12"
           Margin="4,0,0,8"/>

                <Grid Grid.Row="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox
                       x:Name="PasswordBox"
                       Style="{StaticResource RoundedPasswordBox}"
                       PasswordChanged="PasswordBox_PasswordChanged"/>

                    <TextBox x:Name="PasswordTextBox"
                           Grid.Column="0"
                            Style="{StaticResource RoundedTextBox}"
                              Visibility="Collapsed"/>

                    <Button
    Width="36"
    Height="36"
    HorizontalAlignment="Right"
    Margin="0,0,12,0"
    VerticalAlignment="Center"
    Background="Transparent"
    BorderThickness="0"
    Focusable="False"
    Click="TogglePassword_Click">

                        <materialDesign:PackIcon
        x:Name="EyeIcon"
        Kind="EyeOutline"
        Width="20"
        Height="20"
        Foreground="{StaticResource SecondaryTextBrush}"/>

                    </Button>
                </Grid>

                <!-- Error message -->
                <TextBlock Grid.Row="12"
           Text="{Binding ErrorMessage}"
           Foreground="#FF6B6B"
           FontSize="13"
           HorizontalAlignment="Center"
           TextWrapping="Wrap"/>

                <!-- Login button -->
                <Button Grid.Row="14"
        Style="{StaticResource PrimaryButton}"
        Content="Sign In"
        Command="{Binding LoginCommand}"/>

                <!-- Register -->
                <StackPanel Grid.Row="16"
            HorizontalAlignment="Center">

                    <TextBlock Text="Don't have an account?"
               Foreground="{StaticResource SecondaryTextBrush}"
               FontSize="13"
               HorizontalAlignment="Center"/>

                    <Button Content="Create account"
        Click="OpenRegister_Click"
        Background="Transparent"
        BorderThickness="0"
        Foreground="{StaticResource PrimaryBrush}"
        FontWeight="SemiBold"
        Cursor="Hand"
        Padding="0"/>

                </StackPanel>

            </Grid>

        </Border>

        </Grid>

</Window>