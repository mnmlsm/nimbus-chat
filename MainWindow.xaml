<Window x:Class="NimbusChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="NimbusChat"
        Height="600"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        ResizeMode="NoResize">

    <Grid>

        <Border Width="380"
                Padding="35"
                Background="White"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Opacity="0.15"/>
            </Border.Effect>

            <StackPanel>

                <!-- Logo -->

                <TextBlock Text="☁"
                           FontSize="48"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="NimbusChat"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#202124"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,5"/>

                <TextBlock Text="Welcome back 👋"
                           FontSize="15"
                           Foreground="#70757A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Email -->

                <TextBlock Text="Email"
                           FontWeight="SemiBold"/>

                <TextBox Height="40"
                         FontSize="15"
                         Margin="0,8,0,20"
                         Padding="10"
                         Text="{Binding Email,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->

                <TextBlock Text="Password"
           FontWeight="SemiBold"/>

                <Grid Margin="0,8,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hidden password -->
                    <PasswordBox x:Name="PasswordBox"
                 Height="40"
                 Padding="10"
                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- Visible password -->
                    <TextBox x:Name="PasswordTextBox"
             Height="40"
             Padding="10"
             Visibility="Collapsed"
             TextChanged="PasswordTextBox_TextChanged"/>

                    <!-- Eye button -->
                    <Button Grid.Column="1"
        Width="40"
        Height="40"
        Background="Transparent"
        BorderThickness="0"
        Click="TogglePassword_Click">

                        <materialDesign:PackIcon Kind="EyeOutline"
                             Width="22"
                             Height="22"
                             Foreground="#70757A"/>

                    </Button>

                    <Button x:Name="TogglePasswordButton"
        Grid.Column="1"
        Width="40"
        Height="40"
        Background="Transparent"
        BorderThickness="0"
        Click="TogglePassword_Click">

                        <materialDesign:PackIcon x:Name="EyeIcon"
                             Kind="EyeOutline"
                             Width="22"
                             Height="22"
                             Foreground="#70757A"/>

                    </Button>

                </Grid>

                <!-- Error -->

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           Margin="0,0,0,15"
                           HorizontalAlignment="Center"/>

                <!-- Login -->

                <Button Content="Login"
                        Height="45"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="#4F8EF7"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding LoginCommand}"/>

                <!-- Register -->

                <Button Content="Create new account"
                        Height="40"
                        Margin="0,15,0,0"
                        Background="Transparent"
                        BorderBrush="#4F8EF7"
                        BorderThickness="2"
                        Foreground="#4F8EF7"
                        FontWeight="SemiBold"
                        Click="OpenRegister_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>