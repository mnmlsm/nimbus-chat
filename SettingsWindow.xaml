<Window x:Class="NimbusChat.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">

    <Border Margin="20"
            Padding="28"
            CornerRadius="24"
            Background="{DynamicResource CardBackground}">

        <StackPanel>

            <!-- TITLE -->

            <TextBlock x:Name="SettingsTitle"
                       Text="Settings"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock x:Name="SettingsDescription"
                       Text="Customize your experience."
                       Margin="0,6,0,28"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>


            <!-- APPEARANCE -->

            <TextBlock x:Name="AppearanceTitle"
                       Text="Appearance"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock x:Name="AppearanceDescription"
                       Text="Choose how NimbusChat looks."
                       Margin="0,4,0,10"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <ComboBox x:Name="ThemeComboBox"
                      Height="48"
                      SelectedIndex="0"
                      SelectionChanged="ThemeComboBox_SelectionChanged"
                      Style="{StaticResource RoundedComboBox}">

                <ComboBoxItem x:Name="LightThemeItem"
                              Content="Light"/>

                <ComboBoxItem x:Name="DarkThemeItem"
                              Content="Dark"/>

            </ComboBox>


            <!-- LANGUAGE -->

            <TextBlock x:Name="LanguageTitle"
                       Text="Language"
                       Margin="0,22,0,0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock x:Name="LanguageDescription"
                       Text="Choose the language."
                       Margin="0,4,0,10"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <ComboBox x:Name="LanguageComboBox"
                      Height="48"
                      SelectedIndex="0"
                      SelectionChanged="LanguageComboBox_SelectionChanged"
                      Style="{StaticResource RoundedComboBox}">

                <ComboBoxItem x:Name="EnglishLanguageItem"
                              Content="English"
                              Tag="en"/>

                <ComboBoxItem x:Name="GermanLanguageItem"
                              Content="Deutsch"
                              Tag="de"/>

                <ComboBoxItem x:Name="RussianLanguageItem"
                              Content="Русский"
                              Tag="ru"/>

            </ComboBox>


            <!-- APPLICATION -->

            <Separator Margin="0,24,0,20"
                       Background="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock x:Name="ApplicationTitle"
                       Text="Application"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock x:Name="ApplicationName"
                       Text="NimbusChat"
                       Margin="0,7,0,0"
                       FontSize="15"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock x:Name="ApplicationDescription"
                       Text="Weather &amp; Messenger"
                       Margin="0,3,0,0"
                       FontSize="6"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

        </StackPanel>

    </Border>

</Window>