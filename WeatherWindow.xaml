<!-- Weather search dialog -->
<Window x:Class="NimbusChat.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:NimbusChat.ViewModels"
        Title="Weather"
        Height="850"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">

    <Window.DataContext>
        <vm:WeatherViewModel/>
    </Window.DataContext>

    <Grid>

        <!-- Background decoration -->
        <Ellipse Width="420"
                 Height="420"
                 Fill="#18FFFFFF"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="150,-180,0,0"/>

        <Ellipse Width="220"
                 Height="220"
                 Fill="#14FFFFFF"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-80,0,0,-70"/>

        <!-- Main card -->
        <Border Width="450"
                Padding="30"
                Background="{DynamicResource CardBackground}"
                CornerRadius="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>

                <!-- Logo -->
                <Border Width="72"
                        Height="72"
                        CornerRadius="36"
                        Background="{DynamicResource InputBackgroundBrush}"
                        HorizontalAlignment="Center">

                    <materialDesign:PackIcon
                        Kind="CloudSearch"
                        Width="40"
                        Height="40"
                        Foreground="{DynamicResource PrimaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>


                <!-- Title -->
                <TextBlock
                    x:Name="WeatherSearchTitle"
                    Text="Weather Search"
                    Style="{StaticResource TitleText}"
                    FontSize="30"
                    TextWrapping="NoWrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="0,15,0,2"/>

                <!-- Subtitle -->
                <TextBlock
                    x:Name="SearchWeatherAnywhereText"
                    Text="Search weather anywhere"
                    Style="{StaticResource SubtitleText}"
                    FontSize="15"
                    TextWrapping="NoWrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="0,0,0,20"/>


                <!-- City label -->
                <TextBlock
                    x:Name="CityLabelText"
                    Text="CITY"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Margin="4,0,0,6"/>

                <!-- City input -->
                <TextBox
                    Style="{StaticResource RoundedTextBox}"
                    Height="46"
                    Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>


                <!-- Search button -->
                <Button
                    x:Name="SearchWeatherButton"
                    Style="{StaticResource PrimaryButton}"
                    Content="Search Weather"
                    Height="46"
                    Margin="0,16,0,18"
                    Command="{Binding SearchCommand}"/>


                <!-- Current weather result -->
                <Border
                    Background="{DynamicResource InputBackgroundBrush}"
                    CornerRadius="18"
                    Padding="18">

                    <StackPanel>

                        <!-- City -->
                        <TextBlock
                            Text="{Binding CityName}"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"/>


                        <!-- Temperature -->
                        <TextBlock
                            Text="{Binding Temperature}"
                            FontSize="48"
                            FontWeight="Light"
                            Foreground="{DynamicResource PrimaryBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,2,0,0"/>


                        <!-- Weather icon -->
                        <materialDesign:PackIcon
                            Kind="WeatherPartlyCloudy"
                            Width="58"
                            Height="58"
                            Foreground="{DynamicResource PrimaryBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,2"/>


                        <!-- Description -->
                        <TextBlock
                            Text="{Binding Description}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Margin="0,2,0,15"/>


                        <!-- Weather details -->
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <!-- Humidity -->
                            <TextBlock
                                Grid.Row="0"
                                x:Name="HumidityText"
                                Text="💧 Humidity"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="14"/>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding Humidity}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"/>


                            <!-- Wind -->
                            <TextBlock
                                Grid.Row="1"
                                x:Name="WindText"
                                Text="💨 Wind"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="14"
                                Margin="0,9,0,0"/>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Wind}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                Margin="0,9,0,0"/>


                            <!-- Feels like -->
                            <TextBlock
                                Grid.Row="2"
                                x:Name="FeelsLikeText"
                                Text="🌡 Feels Like"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="14"
                                Margin="0,9,0,0"/>

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding FeelsLike}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                Margin="0,9,0,0"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- Dashboard button -->
                <Button
                    x:Name="UseForDashboardButton"
                    Style="{StaticResource PrimaryButton}"
                    Content="Use for Dashboard"
                    Height="46"
                    Margin="0,16,0,0"
                    Click="UseForDashboard_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>