<Window x:Class="NimbusChat.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NimbusChat.ViewModels"
        Title="Weather" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">

    <Window.DataContext>
        <vm:WeatherViewModel/>
    </Window.DataContext>

    <StackPanel Margin="30">

        <TextBlock Text="Weather Search" FontSize="24"/>

        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,10,0,10"/>

        <Button Content="Search"
                Command="{Binding SearchCommand}"/>

        <TextBlock Text="{Binding WeatherResult}"
                   Margin="0,20,0,0"
                   FontSize="16"/>

    </StackPanel>
</Window>