<!-- Weather search dialog layout: city search box plus the current-conditions
     card bound to WeatherViewModel. -->
<Window x:Class="NimbusChat.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:NimbusChat.ViewModels"
        Title="Weather"
        Height="1000"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">

    <Window.DataContext>
        <vm:WeatherViewModel/>
    </Window.DataContext>

    <Grid>

        <!-- Background -->
        <Ellipse Width="420"
                 Height="420"
                 Fill="#18FFFFFF"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="120,-150,0,0"/>

        <Ellipse Width="220"
                 Height="220"
                 Fill="#14FFFFFF"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-70,0,0,-60"/>

        <!-- Card -->
        <Border Width="360"
                Padding="35"
                Background="{StaticResource CardBackground}"
                CornerRadius="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.30"/>
            </Border.Effect>

            <StackPanel>

                <!-- Logo -->
                <Border Width="80"
                        Height="80"
                        CornerRadius="40"
                        Background="#24344E"
                        HorizontalAlignment="Center">

                    <materialDesign:PackIcon
                        Kind="CloudSearch"
                        Width="42"
                        Height="42"
                        Foreground="{StaticResource PrimaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

                <!-- Title -->
                <TextBlock 
    x:Name="WeatherSearchTitle"
    Text="Weather Search"
    Style="{StaticResource TitleText}"
    Margin="0,18,0,0"/>

                <!-- Subtitle -->
                <TextBlock 
    x:Name="SearchWeatherAnywhereText"
    Text="Search weather anywhere"
    Style="{StaticResource SubtitleText}"
    Margin="0,0,0,25"/>

                <!-- Search -->
                <TextBlock 
    x:Name="CityLabelText"
    Text="CITY"
    Foreground="{StaticResource SecondaryTextBrush}"
    FontWeight="SemiBold"
    FontSize="12"
    Margin="4,0,0,8"/>

                <TextBox
                    Style="{StaticResource RoundedTextBox}"
                    Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>

                <Button 
    Style="{StaticResource PrimaryButton}" 
    Content="Search Weather"
    x:Name="SearchWeatherButton"
                    Margin="0,22,0,22"
                    Command="{Binding SearchCommand}"/>

                <!-- Result -->
                <Border
                    Background="{StaticResource InputBackgroundBrush}"
                    CornerRadius="18"
                    Padding="18">

                    <Border
    Background="{StaticResource InputBackgroundBrush}"
    CornerRadius="18"
    Padding="18"
    Margin="0,6,0,0">

                        <StackPanel>

                            <TextBlock
            Text="{Binding CityName}"
            FontSize="24"
            FontWeight="Bold"
            Foreground="White"
            HorizontalAlignment="Center"/>

                            <TextBlock
            Text="{Binding Temperature}"
            FontSize="56"
            FontWeight="Light"
            Foreground="{StaticResource PrimaryBrush}"
            HorizontalAlignment="Center"
            Margin="0,8"/>

                            <materialDesign:PackIcon
    Kind="WeatherPartlyCloudy"
    Width="64"
    Height="64"
    Foreground="{StaticResource PrimaryBrush}"
    HorizontalAlignment="Center"
    Margin="4,12"/>

                            <TextBlock
    Text="{Binding Description}"
    FontSize="20"
    FontWeight="SemiBold"
    Foreground="White"
    HorizontalAlignment="Center"
    Margin="0,8,0,20"/>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" 
           x:Name="HumidityText"
           Text="💧 Humidity" 
           Foreground="White"/>

                                <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Text="{Binding Humidity}"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource PrimaryBrush}"/>

                                <TextBlock Grid.Row="1" 
           x:Name="WindText"
           Text="💨 Wind" 
           Foreground="White"
           Margin="0,10,0,0"/>

                                <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding Wind}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource PrimaryBrush}"/>

                                <TextBlock Grid.Row="2" 
           x:Name="FeelsLikeText"
           Text="🌡 Feels Like" 
           Foreground="White"
           Margin="0,10,0,0"/>

                                <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding FeelsLike}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource PrimaryBrush}"/>

                            </Grid>

                        </StackPanel>

                    </Border>

                </Border>

                <Button 
    x:Name="UseForDashboardButton"
    Style="{StaticResource PrimaryButton}" 
    Content="Use for Dashboard"
    Margin="0,18,0,0" 
    Click="UseForDashboard_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>