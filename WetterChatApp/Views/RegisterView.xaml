<Window x:Class="NimbusChat.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NimbusChat"
        Height="700"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        ResizeMode="NoResize">

    <Grid>

        <Border Width="380"
                Padding="35"
                Background="White"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Opacity="0.15"/>
            </Border.Effect>

            <StackPanel>

                <!-- Logo -->

                <TextBlock Text="☁"
                           FontSize="48"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="NimbusChat"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#202124"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,5"/>

                <TextBlock Text="Create your account"
                           FontSize="15"
                           Foreground="#70757A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Username -->

                <TextBlock Text="Username"
                           FontWeight="SemiBold"/>

                <TextBox Height="40"
                         Margin="0,8,0,18"
                         Padding="10"
                         FontSize="15"
                         Text="{Binding Username,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Email -->

                <TextBlock Text="Email"
                           FontWeight="SemiBold"/>

                <TextBox Height="40"
                         Margin="0,8,0,18"
                         Padding="10"
                         FontSize="15"
                         Text="{Binding Email,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->

                <TextBlock Text="Password"
                           FontWeight="SemiBold"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             Margin="0,8,0,18"
                             Padding="10"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- Confirm Password -->

                <TextBlock Text="Confirm Password"
                           FontWeight="SemiBold"/>

                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="40"
                             Margin="0,8,0,18"
                             Padding="10"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                <Button Content="Create Account"
                        Height="45"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="#4F8EF7"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding RegisterCommand}"/>

                <!-- Error -->

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>

                <!-- Register -->

                <!-- Back -->

            </StackPanel>

        </Border>
        <Button Content="Back to Login"
                        BorderBrush="#4F8EF7"
                        BorderThickness="2"
                        Background="Transparent"
                        Foreground="#4F8EF7"
                        FontWeight="SemiBold"
                        Click="BackToLogin_Click" Margin="95,601,95,33"/>

    </Grid>

</Window>