<Window x:Class="NimbusChat.WetterChatApp.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NimbusChat.WetterChatApp.ViewModels"
        Title="Registrierung"
        Height="420" Width="420"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:RegisterViewModel />
    </Window.DataContext>

    <Grid Background="#F4F6F8">
        <StackPanel Width="280"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="Registrieren"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Username" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Margin="0,0,0,10"/>

            <TextBlock Text="E-Mail" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Passwort" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="30"
                         Margin="0,0,0,15"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <Button Content="Registrieren"
                    Height="35"
                    Command="{Binding RegisterCommand}"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       Margin="0,10,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding SuccessMessage}"
                       Foreground="Gray"
                       Margin="0,6,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>